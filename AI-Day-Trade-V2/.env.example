# AI Day Trade V2. Use PAPER account keys. Never upload your real .env.
PAPER=true
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
V2_SYMBOLS=NVDA,AMD,SOXL,TSLA,TSLL,COIN,IBIT,XBI,LABU,OXY,XOP,GUSH,NEM,GDX,NUGT,IWM,TNA,JPM,KRE,FAS
V2_CHECK_SECONDS=10
# Position and group percentages target approximate daily exposure, not loss.
# A 3x fund gets one third of the allocation's dollars.
V2_ALLOCATION_PCT=0.02
V2_GROUP_EXPOSURE_PCT=0.10
V2_CASH_BUFFER_PCT=0.05
V2_STOP_LOSS_PCT=0.03
V2_TAKE_PROFIT_PCT=0.06
# Live mode, when deliberately enabled, needs separate ALPACA_API_KEY /
# ALPACA_SECRET_KEY and ALLOW_LIVE_TRADING=I_UNDERSTAND.
# Trading startup enforces account-wide max_margin_multiplier=1 and no_shorting=True.
# --check only reads account/data endpoints and makes no account changes.
